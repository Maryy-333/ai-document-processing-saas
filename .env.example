# Copy this file to .env for local development.
# Never commit a real .env file.

# --- Application ---
APP_NAME="AI Invoice Extraction Platform"
ENVIRONMENT=local
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database ---
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/invoice_extractor

# --- Auth (JWT) ---
# REQUIRED: override with a strong random value outside of local/test.
JWT_SECRET_KEY=INSECURE-DEV-ONLY-CHANGE-ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File storage ---
STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# --- Logging ---
LOG_LEVEL=INFO

# --- AI provider (Phase 7) ---
AI_PROVIDER=anthropic
AI_MODEL_NAME=claude-haiku-4-5
# REQUIRED for real AI extraction to work. Never commit a real key here —
# this file is committed to version control; put the real value only in
# your local, untracked .env.
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
